+/// Root variables, for a host hook (Player::hook_after_root_function); names as in get_root_variable.
+pub trait RootVars {
+    fn get(&mut self, name: &str) -> ExternalValue;
+    fn set(&mut self, name: &str, value: ExternalValue);
+}
+
+thread_local! {
+    static HOST_HOOKS: std::cell::RefCell<Vec<Box<dyn FnMut(&mut dyn RootVars)>>> = Default::default();
+}
+
+struct HostVars<'a, 'b, 'gc>(&'a mut Activation<'b, 'gc>);
+
+impl RootVars for HostVars<'_, '_, '_> {
+    fn get(&mut self, name: &str) -> ExternalValue {
+        let key = AvmString::new_utf8(self.0.gc(), format!("_root.{name}"));
+        self.0.get_variable(key)
+            .and_then(|value| ExternalValue::from_avm1(self.0, value.into()))
+            .unwrap_or(ExternalValue::Undefined)
+    }
+
+    fn set(&mut self, name: &str, value: ExternalValue) {
+        let key = AvmString::new_utf8(self.0.gc(), format!("_root.{name}"));
+        let value = value.into_avm1(self.0);
+        self.0.set_variable(key, value).ok();
+    }
+}
+
+fn host_hooked<'gc, const N: usize>(
+    activation: &mut Activation<'_, 'gc>,
+    this: Object<'gc>,
+    args: &[Value<'gc>],
+) -> Result<Value<'gc>, crate::avm1::Error<'gc>> {
+    let Some(root) = activation.context.stage.root_clip().and_then(|root| root.object1()) else {
+        return Ok(Value::Undefined);
+    };
+    // the original, with the caller's own this
+    let saved = AvmString::new_utf8(activation.gc(), format!("__hostOriginal{N}"));
+    let Value::Object(original) = root.get(saved, activation)? else { return Ok(Value::Undefined) };
+    let result = original.call(saved, activation, this.into(), args)?;
+    HOST_HOOKS.with(|hooks| {
+        if let Ok(mut hooks) = hooks.try_borrow_mut() {
+            if let Some(hook) = hooks.get_mut(N) {
+                hook(&mut HostVars(activation));
+            }
+        }
+    });
+    Ok(result)
+}
