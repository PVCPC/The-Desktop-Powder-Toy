+    /// Runs `hook` right after every call of the root ActionScript function `name` (up to 4 hooks per thread), inside
+    /// the game's own frame: a native wrapper calls the original, then the hook, which reads and writes root variables.
+    pub fn hook_after_root_function(&mut self, name: &str, hook: Box<dyn FnMut(&mut dyn RootVars)>) -> Result<(), String> {
+        let slot = HOST_HOOKS.with(|h| h.borrow().len());
+        let native: crate::avm1::NativeFunction = match slot {
+            0 => host_hooked::<0>,
+            1 => host_hooked::<1>,
+            2 => host_hooked::<2>,
+            3 => host_hooked::<3>,
+            _ => return Err("Too many host hooks".into()),
+        };
+        self.update(|context| {
+            let root = context.stage.root_clip().ok_or("Missing root movie")?;
+            let object = root.object1().ok_or("Root movie is not AVM1")?;
+            let mut activation = Activation::from_nothing(
+                context, ActivationIdentifier::root("Native host hook"), root,
+            );
+            let key = AvmString::new_utf8(activation.gc(), name);
+            let original = object.get(key, &mut activation).map_err(|error| format!("{error:?}"))?;
+            let saved = AvmString::new_utf8(activation.gc(), format!("__hostOriginal{slot}"));
+            object.set(saved, original, &mut activation).map_err(|error| format!("{error:?}"))?;
+            let fn_proto = activation.resolve_prototype([AvmString::new_utf8(activation.gc(), "Function")]);
+            let function = crate::avm1::FunctionObject::native(native).build(activation.strings(), fn_proto, None);
+            object.set(key, function, &mut activation).map_err(|error| format!("{error:?}"))
+        })?;
+        HOST_HOOKS.with(|h| h.borrow_mut().push(hook));
+        Ok(())
+    }
